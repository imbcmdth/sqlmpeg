{
  "inputs": [
    "clip.mp4"
  ],
  "sources": {
    "a": 0
  },
  "nodes": [
    {
      "id": "n1",
      "filter": "scale",
      "args": {
        "w": "iw*0.5",
        "h": "-2"
      },
      "inputs": [
        "src:a"
      ]
    },
    {
      "id": "n1_split",
      "filter": "split",
      "args": {
        "n": 2
      },
      "inputs": [
        "n1"
      ]
    },
    {
      "id": "n2",
      "filter": "overlay",
      "args": {
        "x": 10,
        "y": 10
      },
      "inputs": [
        "n1_split:0",
        "n1_split:1"
      ]
    }
  ],
  "output": "n2"
}
